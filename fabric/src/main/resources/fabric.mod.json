{
  "schemaVersion": 1,
  "id": "createtransfer",
  "version": "${version}",
  "name": "Create: Transfer",
  "description": "This mod adds a single block: Transmission Chain!\n\nThis block can be used to power belt in a cleaner way without using encased chain drive.",
  "authors": [
    "SerpensSolida"
  ],
  "contact": {
    "sources": "${github_repo}"
  },
  "license": "MIT",
  "icon": "assets/createtransfer/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.serpenssolida.createtransfer.fabric.CreateTransferFabric"
    ]
  },
  "mixins": [
    "createtransfer.mixins.json",
    "createtransfer-common.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": "${create_version}"
  }
}